{
    "openapi": "3.1.2",
    "info": {
        "title": "KoryHub",
        "version": "1.0.0",
        "description": "API du CLI kory (TRD \u00a717). Une route ajout\u00e9e ne casse jamais un client existant."
    },
    "servers": [
        {
            "url": "http://api.koryhub.test/v1"
        }
    ],
    "paths": {
        "/": {
            "get": {
                "operationId": "v1.index",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "version": {
                                            "type": "string",
                                            "const": "v1"
                                        }
                                    },
                                    "required": [
                                        "name",
                                        "version"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/audit": {
            "post": {
                "operationId": "v1.audit",
                "description": "\u00c9tat de chaque version : `up_to_date`, `update_available`, `deprecated`, `removed` ou\n`not_found` ; `latest_version` est la derni\u00e8re version stable. `at_risk` arrive avec la\nmod\u00e9ration (W07).",
                "summary": "Auditer des versions install\u00e9es",
                "tags": [
                    "Audit"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "modules": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "pattern": "#^@[a-z0-9-]+/[a-z0-9-]+$#"
                                                },
                                                "version": {
                                                    "type": "string",
                                                    "maxLength": 64
                                                }
                                            },
                                            "required": [
                                                "name",
                                                "version"
                                            ]
                                        },
                                        "minItems": 1,
                                        "maxItems": 200
                                    }
                                },
                                "required": [
                                    "modules"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "results": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "version": {
                                                        "type": "string"
                                                    },
                                                    "state": {
                                                        "type": "string",
                                                        "description": "up_to_date, update_available, deprecated, removed ou not_found.",
                                                        "enum": [
                                                            "not_found",
                                                            "removed",
                                                            "deprecated",
                                                            "update_available",
                                                            "up_to_date"
                                                        ]
                                                    },
                                                    "latest_version": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ],
                                                        "description": "Derni\u00e8re version stable, ou null."
                                                    },
                                                    "message": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ],
                                                        "description": "Message de d\u00e9pr\u00e9ciation de l'auteur, ou null."
                                                    }
                                                },
                                                "required": [
                                                    "name",
                                                    "version",
                                                    "state",
                                                    "latest_version",
                                                    "message"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "results"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/device": {
            "post": {
                "operationId": "v1.auth.device",
                "description": "Le code affich\u00e9 (user_code) est valable 15 minutes ; le CLI interroge ensuite\nPOST /v1/auth/device/token toutes les `interval` secondes.",
                "summary": "Demander un code de connexion",
                "tags": [
                    "DeviceAuthorization"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "device_code": {
                                            "type": "string",
                                            "description": "Code secret de l'appareil, \u00e0 renvoyer pour obtenir le jeton."
                                        },
                                        "user_code": {
                                            "type": "string",
                                            "description": "Code \u00e0 afficher (ABCD-EFGH)."
                                        },
                                        "verification_uri": {
                                            "type": "string",
                                            "description": "Adresse o\u00f9 saisir le code."
                                        },
                                        "verification_uri_complete": {
                                            "type": "string",
                                            "description": "Adresse avec le code d\u00e9j\u00e0 rempli."
                                        },
                                        "expires_in": {
                                            "type": "integer",
                                            "description": "Dur\u00e9e de validit\u00e9 du code, en secondes.",
                                            "const": 900
                                        },
                                        "interval": {
                                            "type": "integer",
                                            "description": "D\u00e9lai entre deux interrogations, en secondes.",
                                            "const": 5
                                        }
                                    },
                                    "required": [
                                        "device_code",
                                        "user_code",
                                        "verification_uri",
                                        "verification_uri_complete",
                                        "expires_in",
                                        "interval"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/auth/device/token": {
            "post": {
                "operationId": "v1.auth.device.token",
                "description": "Tant que le code n'est pas autoris\u00e9 : 400 `authorization_pending` (ou `slow_down` si le CLI\ninterroge trop vite). Refus\u00e9 : 400 `access_denied`. Expir\u00e9, inconnu ou d\u00e9j\u00e0 utilis\u00e9 :\n400 `expired_token`. Autoris\u00e9 : le jeton, remis une seule fois.",
                "summary": "Obtenir le jeton",
                "tags": [
                    "DeviceAuthorization"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "device_code": {
                                        "type": "string",
                                        "maxLength": 128
                                    }
                                },
                                "required": [
                                    "device_code"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "description": "Jeton \u00e0 envoyer dans l'en-t\u00eate Authorization: Bearer."
                                        },
                                        "token_name": {
                                            "type": "string",
                                            "description": "Nom du jeton, visible dans les r\u00e9glages du site."
                                        },
                                        "expires_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "Date d'expiration (ISO 8601, UTC), ou null pour un jeton sans expiration."
                                        },
                                        "handle": {
                                            "type": "string",
                                            "description": "Nom @auteur du compte."
                                        }
                                    },
                                    "required": [
                                        "token",
                                        "token_name",
                                        "expires_at",
                                        "handle"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/modules/{author}/{module}/versions/{version}/download": {
            "get": {
                "operationId": "v1.modules.versions.download",
                "description": "Redirige (302) vers un lien sign\u00e9 valable 5 minutes. Refus : `not_found` (404),\n`version_removed` (410), `download_limit_guest` ou `download_limit_user` (429, avec\n`retry_at` en UTC et l'en-t\u00eate `Retry-After`).",
                "summary": "T\u00e9l\u00e9charger une version",
                "tags": [
                    "Download"
                ],
                "parameters": [
                    {
                        "name": "author",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "module",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "version",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "",
                        "headers": {
                            "Location": {
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/meta": {
            "get": {
                "operationId": "v1.meta",
                "summary": "Versions de l'API et du CLI",
                "tags": [
                    "Meta"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "api_version": {
                                            "type": "string",
                                            "description": "Version de l'API.",
                                            "const": "v1"
                                        },
                                        "minimum_cli_version": {
                                            "type": "string",
                                            "description": "Version minimale du CLI accept\u00e9e (x.y.z)."
                                        },
                                        "latest_cli_version": {
                                            "type": "string",
                                            "description": "Derni\u00e8re version publi\u00e9e du CLI (x.y.z)."
                                        }
                                    },
                                    "required": [
                                        "api_version",
                                        "minimum_cli_version",
                                        "latest_cli_version"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/modules/{author}/{module}": {
            "get": {
                "operationId": "v1.modules.show",
                "description": "Versions publi\u00e9es, d\u00e9pr\u00e9ci\u00e9es et retir\u00e9es, les plus r\u00e9centes d'abord.",
                "summary": "Un module et ses versions",
                "tags": [
                    "Module"
                ],
                "parameters": [
                    {
                        "name": "author",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "module",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "description": "Nom complet @auteur/nom."
                                        },
                                        "visibility": {
                                            "type": "string",
                                            "description": "public ou private.",
                                            "enum": [
                                                "public",
                                                "private"
                                            ]
                                        },
                                        "status": {
                                            "type": "string",
                                            "description": "active ou archived.",
                                            "enum": [
                                                "active",
                                                "archived"
                                            ]
                                        },
                                        "latest_version": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "Derni\u00e8re version stable publi\u00e9e, ou null."
                                        },
                                        "description": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "language": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "certified": {
                                            "type": "boolean",
                                            "description": "Certification (W06) : toujours false pour l'instant."
                                        },
                                        "download_count": {
                                            "type": "integer",
                                            "description": "T\u00e9l\u00e9chargements, toutes versions."
                                        },
                                        "versions": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "version": {
                                                        "type": "string"
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "description": "published, deprecated ou removed.",
                                                        "enum": [
                                                            "submitted",
                                                            "published",
                                                            "rejected",
                                                            "deprecated",
                                                            "removed"
                                                        ]
                                                    },
                                                    "prerelease": {
                                                        "type": "boolean"
                                                    },
                                                    "published_at": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "sha256": {
                                                        "type": "string",
                                                        "description": "Empreinte SHA-256 de l'archive."
                                                    },
                                                    "size": {
                                                        "type": "integer"
                                                    },
                                                    "deprecation_message": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "version",
                                                    "status",
                                                    "prerelease",
                                                    "published_at",
                                                    "sha256",
                                                    "size",
                                                    "deprecation_message"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "name",
                                        "visibility",
                                        "status",
                                        "latest_version",
                                        "description",
                                        "language",
                                        "certified",
                                        "download_count",
                                        "versions"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/modules/{author}/{module}/versions/{version}": {
            "get": {
                "operationId": "v1.modules.versions.show",
                "summary": "Une version : pr\u00e9requis et fichiers (chemin, taille, empreinte)",
                "tags": [
                    "Module"
                ],
                "parameters": [
                    {
                        "name": "author",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "module",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "version",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "version": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string",
                                            "description": "published, deprecated ou removed.",
                                            "enum": [
                                                "submitted",
                                                "published",
                                                "rejected",
                                                "deprecated",
                                                "removed"
                                            ]
                                        },
                                        "prerelease": {
                                            "type": "boolean"
                                        },
                                        "license": {
                                            "type": "string",
                                            "description": "Identifiant SPDX (MIT, Apache-2.0\u2026).",
                                            "enum": [
                                                "MIT",
                                                "Apache-2.0",
                                                "BSD-2-Clause",
                                                "BSD-3-Clause",
                                                "ISC",
                                                "MPL-2.0",
                                                "GPL-2.0",
                                                "GPL-3.0",
                                                "LGPL-3.0",
                                                "AGPL-3.0",
                                                "Unlicense"
                                            ]
                                        },
                                        "language": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "published_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "sha256": {
                                            "type": "string"
                                        },
                                        "size": {
                                            "type": "integer"
                                        },
                                        "deprecation_message": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "requires": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "ecosystem": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "version": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "ecosystem",
                                                    "name",
                                                    "version"
                                                ]
                                            }
                                        },
                                        "files": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "path": {
                                                        "type": "string"
                                                    },
                                                    "size": {
                                                        "type": "integer"
                                                    },
                                                    "sha256": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "path",
                                                    "size",
                                                    "sha256"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "name",
                                        "version",
                                        "status",
                                        "prerelease",
                                        "license",
                                        "language",
                                        "published_at",
                                        "sha256",
                                        "size",
                                        "deprecation_message",
                                        "requires",
                                        "files"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/auth/token": {
            "delete": {
                "operationId": "v1.auth.token.destroy",
                "summary": "R\u00e9voquer le jeton de ce terminal",
                "tags": [
                    "Token"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/user": {
            "get": {
                "operationId": "v1.user",
                "summary": "Compte et jeton en cours",
                "tags": [
                    "User"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "handle": {
                                            "type": "string",
                                            "description": "Nom @auteur."
                                        },
                                        "name": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "Nom affich\u00e9, ou null."
                                        },
                                        "token_name": {
                                            "type": "string",
                                            "description": "Nom du jeton utilis\u00e9."
                                        },
                                        "token_expires_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "Expiration du jeton (ISO 8601, UTC), ou null pour un jeton sans expiration."
                                        },
                                        "publication_terms_accepted": {
                                            "type": "boolean",
                                            "description": "Droits certifi\u00e9s et message de prudence lus (premier kory push fait)."
                                        }
                                    },
                                    "required": [
                                        "handle",
                                        "name",
                                        "token_name",
                                        "token_expires_at",
                                        "publication_terms_accepted"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/modules/{author}/{module}/versions": {
            "post": {
                "operationId": "v1.modules.versions.store",
                "description": "Archive .tar.gz (10 Mo au plus) et son empreinte SHA-256. Premier envoi du compte :\n`rights_certified` et `notice_accepted`. Nouveau module : `visibility` (priv\u00e9 par d\u00e9faut).\nRefus : `{message, code}` avec, entre autres, `secret_detected`, `version_exists`,\n`version_not_higher`, `binary_forbidden`, `svg_forbidden`, `terms_required`, `email_unverified`.",
                "summary": "Publier une version",
                "tags": [
                    "Version"
                ],
                "parameters": [
                    {
                        "name": "author",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "module",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "archive": {
                                        "type": "string",
                                        "format": "binary",
                                        "contentMediaType": "application/octet-stream"
                                    },
                                    "sha256": {
                                        "type": "string",
                                        "pattern": "^[0-9a-fA-F]{64}$"
                                    },
                                    "visibility": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "enum": [
                                            "public",
                                            "private",
                                            null
                                        ]
                                    },
                                    "rights_certified": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    },
                                    "notice_accepted": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "archive",
                                    "sha256"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "description": "Nom complet @auteur/nom."
                                        },
                                        "version": {
                                            "type": "string",
                                            "description": "Num\u00e9ro publi\u00e9."
                                        },
                                        "sha256": {
                                            "type": "string",
                                            "description": "Empreinte SHA-256 de l'archive."
                                        },
                                        "files_count": {
                                            "type": "integer",
                                            "description": "Nombre de fichiers du kory (hors kory.json et README.md)."
                                        },
                                        "size": {
                                            "type": "integer",
                                            "description": "Taille de l'archive en octets."
                                        },
                                        "url": {
                                            "type": "string",
                                            "description": "Adresse de la fiche."
                                        }
                                    },
                                    "required": [
                                        "name",
                                        "version",
                                        "sha256",
                                        "files_count",
                                        "size",
                                        "url"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
