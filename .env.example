APP_NAME=KoryHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://koryhub.test:8000

# Domaines des quatre espaces (TRD section 6)
KORYHUB_DOMAIN_MAIN=koryhub.test
KORYHUB_DOMAIN_API=api.koryhub.test
KORYHUB_DOMAIN_DOCS=docs.koryhub.test
KORYHUB_DOMAIN_ADMIN=admin.koryhub.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Utilisateur de l'application : droits limités (TRD §21)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koryhub
DB_USERNAME=koryhub_app
DB_PASSWORD=mot-de-passe-factice

# Utilisateur des migrations et des tests : tous droits
# Migrations : php artisan migrate --database=mysql_migrate
DB_MIGRATE_USERNAME=koryhub_migrate
DB_MIGRATE_PASSWORD=mot-de-passe-factice
DB_TEST_DATABASE=koryhub_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.koryhub.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comptes de demonstration (php artisan db:seed) : mot de passe choisi par le developpeur
KORYHUB_DEMO_PASSWORD=mot-de-passe-factice

# Recherche de secrets a la publication (W03) : chemin complet de gitleaks si la commande n est pas dans le PATH du serveur
KORYHUB_GITLEAKS_BINARY=gitleaks
# Disque des archives des kory : local en developpement, compatible S3 (R2) en production
KORYHUB_ARCHIVES_DISK=local

# Telechargements (W04) : limites par heure, sans compte (par adresse IP) et par compte connecte
KORYHUB_DOWNLOADS_GUEST_PER_HOUR=60
KORYHUB_DOWNLOADS_USER_PER_HOUR=5000

# Recherche (W05) : moteur Scout ; database = index plein texte MySQL
SCOUT_DRIVER=database

# Rapport de certification PDF (W06) : pilote chrome (chrome-php/chrome, extension PHP sockets) ;
# chemin de chrome.exe si Chrome n est pas trouve automatiquement
LARAVEL_PDF_DRIVER=chrome
LARAVEL_PDF_CHROME_BINARY=
